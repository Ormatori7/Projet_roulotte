# Port d'écoute de l'API
PORT=3000

# Fichier SQLite de la base
DATABASE_URL="file:./dev.db"

# Secret de signature des jetons JWT : 16 caractères au moins, à changer
JWT_SECRET=""

# Durée de validité d'un jeton (facultatif, 2h par défaut)
JWT_EXPIRES_IN="2h"

# Origine autorisée par CORS : l'adresse du front
CORS_ORIGIN="http://localhost:5173"
